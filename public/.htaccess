# Mi Mundo Español — Apache yapılandırması
# Canonical host: https://www.mimundoespanol.com
# Bu adres src/lib/seo.config.ts içindeki SITE_URL ile aynı olmalı.

AddDefaultCharset UTF-8

# ⚠️ Aşağıdaki iki satır bazı paylaşımlı hostinglerde (AllowOverride kısıtlıysa)
# "500 Internal Server Error" verir. Yayına aldıktan sonra site açılmıyorsa
# ÖNCE bu iki satırı yorum satırı yapıp deneyin — geri kalan kurallar çalışır.
Options -Indexes

# Ön-üretilmiş sayfalar (/dersler -> /dersler/index.html) sonuna "/" eklemek
# için 301 atmasın; aksi halde canonical adres yönlendirmeye düşer.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Tek canonical adres: https + www ---
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.mimundoespanol.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.mimundoespanol.com%{REQUEST_URI} [R=301,L]

  # --- Build sırasında üretilen statik SEO sayfaları ---
  # /dersler isteğini yönlendirme yapmadan /dersler/index.html olarak sun.
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # --- Geri kalan rotalar (ör. /blog/yazi-adi) SPA'ya devredilir ---
  # Ana sayfanın index.html'i yerine canonical bildirmeyen kabuk kullanılır;
  # doğru adresi React yüklenince Seo bileşeni yazar.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ spa-fallback.html [QSA,L]
</IfModule>

# --- Sıkıştırma ---
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml \
    application/manifest+json
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml \
    application/manifest+json
</IfModule>

# --- Önbellekleme ---
<IfModule mod_headers.c>
  # Vite hash'li dosyalar: içerik değişirse dosya adı da değişir, uzun tut.
  <FilesMatch "\.(js|mjs|css|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML her zaman taze olsun; yoksa yeni deploy kullanıcıya ulaşmaz.
  <FilesMatch "\.(html|json|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # --- Güvenlik başlıkları ---
  Header set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # HSTS: SSL sertifikası sorunsuz çalıştığı DOĞRULANDIKTAN sonra aç.
  # Erken açılırsa ve sertifika bozulursa site tarayıcıda erişilemez hale gelir.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

ServerSignature Off
